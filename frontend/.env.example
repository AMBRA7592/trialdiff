# Local development database. See frontend/README.md ("Local development")
# for the full flow: start Postgres, apply postgres/migrations/*.sql in
# order, then seed with scripts/seed_from_records.py + sqlite_to_postgres.py.
DATABASE_URL=postgres://trialdiff:trialdiff@localhost:5432/trialdiff?sslmode=disable

# Max connections in the postgres.js pool (default 5).
DATABASE_POOL_MAX=5
