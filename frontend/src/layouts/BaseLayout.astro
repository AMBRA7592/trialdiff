---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TrialDiff",
  description = "Open, reproducible ClinicalTrials.gov amendment evidence records.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="TrialDiff" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <footer class="site-footer">
      <div class="page-shell site-footer-inner">
        <span>TrialDiff · deterministic, uncalibrated triage metadata</span>
        <a href="https://github.com/AMBRA7592/trialdiff">Repository &amp; data</a>
      </div>
    </footer>
  </body>
</html>
