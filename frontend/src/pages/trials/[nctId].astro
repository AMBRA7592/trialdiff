---
import { ArrowLeft, ExternalLink } from "@lucide/astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatNumber, severityClass, severityLabel, titleCase } from "@/lib/format";
import { getTrialDetail } from "@/queries/trials";

const nctId = String(Astro.params.nctId ?? "").toUpperCase();
const data = await getTrialDetail(nctId);
const trial = data.trial;
const title = trial ? `${trial.nctId} | TrialDiff` : "TrialDiff trial detail";
const description = trial
  ? `${trial.nctId} amendment history: ${data.patchCount} adjacent patches, ${data.events.length} material events · deterministic, uncalibrated triage metadata`
  : "TrialDiff amendment history for a ClinicalTrials.gov study.";

if (!data.databaseReady) {
  Astro.response.status = 503;
} else if (!trial) {
  Astro.response.status = 404;
}
---

<BaseLayout title={title} description={description}>
  <main class="page-shell stack" id="main-content">
    <a class="button" href="/">
      <ArrowLeft size={16} aria-hidden="true" />
      Back to feed
    </a>

    {
      data.databaseReady && trial ? (
        <>
          <header class="panel panel-pad">
            <div class="header-row">
              <div>
                <p class="eyebrow">{trial.nctId}</p>
                <h1>{trial.briefTitle ?? "Untitled study"}</h1>
                {trial.officialTitle && <p class="lede">{trial.officialTitle}</p>}
              </div>
              <a class="button" href={`https://clinicaltrials.gov/study/${trial.nctId}`}>
                ClinicalTrials.gov
                <ExternalLink size={16} aria-hidden="true" />
              </a>
            </div>
          </header>

          <section class="grid trial-summary-grid">
            <div class="panel panel-pad">
              <div class="stat-label">Sponsor</div>
              <div class="event-title">{trial.leadSponsor ?? "Unknown"}</div>
            </div>
            <div class="panel panel-pad">
              <div class="stat-label">Status</div>
              <div class="event-title">{trial.overallStatus ? titleCase(trial.overallStatus) : "Unknown"}</div>
            </div>
            <div class="panel panel-pad">
              <div class="stat-label">Versions</div>
              <div class="stat-value">{formatNumber(data.versionCount)}</div>
            </div>
            <div class="panel panel-pad">
              <div class="stat-label">Adjacent patches</div>
              <div class="stat-value">{formatNumber(data.patchCount)}</div>
            </div>
          </section>

          <section class="panel panel-pad disclaimer">
            Severity is deterministic, reproducible, uncalibrated triage metadata, not validated review priority or proven wrongdoing. New Evidence Record packages are generated for deterministic event-class membership, not by triage rank alone.
          </section>

          <section class="panel">
            <div class="section-head">
              <h2>Material event timeline</h2>
              <span class="section-count">{data.events.length} shown</span>
            </div>
            <div>
              {data.events.map((event) => (
                <article class="event">
                  <div>
                    <span class={severityClass(event.severity)}>{severityLabel(event.severity)}</span>
                    <div class="event-date">{event.submittedDate ?? "Date unavailable"}</div>
                  </div>
                  <div>
                    <div class="event-title">{titleCase(event.category)}</div>
                    <div class="event-meta">
                      <span>v{event.fromVersion} to v{event.toVersion}</span>
                      {event.timingContext && <span>{titleCase(event.timingContext)}</span>}
                      {event.severity !== event.severityPreTiming && (
                        <span>Base triage: {titleCase(event.severityPreTiming)}</span>
                      )}
                      <a href={`/trials/${trial.nctId}/patches/${event.fromVersion}-to-${event.toVersion}`}>
                        Inspect patch
                      </a>
                      {event.evidenceEventId && <a href={`/events/${event.evidenceEventId}`}>Evidence Record</a>}
                    </div>
                  </div>
                  <div class="path-list">
                    {event.changedPaths.slice(0, 3).map((path) => (
                      <div class="path-item" title={path}>{path}</div>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </section>
        </>
      ) : (
        <section class="panel panel-pad notice">
          <div class="notice-title">{data.databaseReady ? "Trial not found" : "Evidence database unavailable"}</div>
          <div>
            {data.databaseReady
              ? "No trial record exists for this NCT ID."
              : "The corpus database is not reachable right now. Try again shortly."}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
