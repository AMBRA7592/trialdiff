---
import { ArrowLeft } from "@lucide/astro";

import PatchInspector from "@/components/PatchInspector.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPatchInspection } from "@/queries/patches";
import type { PatchInspectionData } from "@/queries/patches";

const nctId = String(Astro.params.nctId ?? "").toUpperCase();
const range = String(Astro.params.range ?? "");
const match = range.match(/^(\d+)-to-(\d+)$/);
const fromVersion = match ? Number(match[1]) : Number.NaN;
const toVersion = match ? Number(match[2]) : Number.NaN;
const data: PatchInspectionData = Number.isFinite(fromVersion) && Number.isFinite(toVersion)
  ? await getPatchInspection(nctId, fromVersion, toVersion)
  : {
      databaseReady: true,
      fromVersion: 0,
      toVersion: 0,
      events: [],
      databaseError: "Invalid patch range.",
    };

if (!data.databaseReady) {
  Astro.response.status = 503;
} else if (!data.patch) {
  Astro.response.status = 404;
}
---

<BaseLayout
  title={`${nctId} patch ${range} | TrialDiff`}
  description={`Field-level registry diff for ${nctId}, version ${fromVersion} to ${toVersion}.`}
>
  <main class="page-shell stack" id="main-content">
    <a class="button" href={`/trials/${nctId}`}>
      <ArrowLeft size={16} aria-hidden="true" />
      Back to trial
    </a>

    {
      data.databaseReady && data.patch ? (
        <>
          <header class="panel panel-pad">
            <p class="eyebrow">{data.trial?.nctId ?? nctId}</p>
            <h1>{data.trial?.briefTitle ?? "Patch inspection"}</h1>
            <p class="lede">
              Version {data.fromVersion} to {data.toVersion}
              {data.trial?.leadSponsor ? ` · ${data.trial.leadSponsor}` : ""}
            </p>
          </header>

          <PatchInspector
            nctId={data.trial?.nctId ?? nctId}
            fromVersion={data.fromVersion}
            toVersion={data.toVersion}
            events={data.events}
            provenance={data.patch.provenance}
            enriched={data.patch.enriched}
            rawOperations={data.patch.operations}
          />
        </>
      ) : (
        <section class="panel panel-pad notice">
          <div class="notice-title">{data.databaseReady ? "Patch not found" : "Evidence database unavailable"}</div>
          <div>
            {data.databaseReady
              ? "No patch record exists for this version range."
              : "The corpus database is not reachable right now. Try again shortly."}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
