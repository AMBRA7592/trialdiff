---
import {
  Activity,
  BookOpen,
  Clock3,
  Database,
  ExternalLink,
  FileSearch,
  Gauge,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatNumber, severityClass, severityLabel, titleCase } from "@/lib/format";
import { rankChangedPaths } from "@/lib/pathRanking";
import { getHomeData, normalizeLens } from "@/queries/feed";
import type { EvidenceRecordRow, Lens, TrialLensRow } from "@/queries/types";

const activeLens = normalizeLens(Astro.url.searchParams.get("lens"));
const data = await getHomeData();

if (!data.databaseReady) {
  Astro.response.status = 503;
} else {
  Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=600");
}

const lensCopy: Record<Lens, { label: string; description: string; href: string }> = {
  "post-completion": {
    label: "Post-recruitment evidence",
    description: "Evidence Records with deterministic triage metadata and explicit claim boundaries.",
    href: "/?lens=post-completion",
  },
  recent: {
    label: "Recent material activity",
    description: "Latest high-signal amendments across the corpus.",
    href: "/?lens=recent",
  },
  "critical-density": {
    label: "Critical-triage density",
    description: "Trials where a larger share of amendments carry the critical triage label.",
    href: "/?lens=critical-density",
  },
  "amendment-intensity": {
    label: "Amendment intensity",
    description: "Trials with the heaviest amendment volume.",
    href: "/?lens=amendment-intensity",
  },
};

const activeRows: TrialLensRow[] =
  activeLens === "amendment-intensity" ? data.amendmentIntensityTrials : data.criticalDensityTrials;

const activeEvidenceRows: EvidenceRecordRow[] = data.postRecruitmentEvidenceRecords;

const lensIcons = {
  "post-completion": FileSearch,
  recent: Clock3,
  "critical-density": Gauge,
  "amendment-intensity": Activity,
};

const lensTitle =
  activeLens === "critical-density" ? "Trials by critical-triage density" : "Trials by amendment intensity";

// Mirrors trialdiff/classifier/materiality.py is_results_reconciliation_patch:
// "/resultsSection" itself or nested paths under it, or "/hasResults".
const ruleSetHashes = data.corpusStamp.ruleSetHashes;
const firstRuleSetHash = ruleSetHashes.length > 0 ? ruleSetHashes[0] : undefined;
const ruleSetLabel =
  ruleSetHashes.length === 1 && firstRuleSetHash
    ? `rule set ${firstRuleSetHash.slice(0, 12)}`
    : ruleSetHashes.length > 1
      ? `${ruleSetHashes.length} rule sets`
      : "rule set unavailable";
---

<BaseLayout
  title="TrialDiff"
  description="Open, reproducible ClinicalTrials.gov amendment evidence records."
>
  <main class="page-shell stack" id="main-content">
    <header class="panel panel-pad">
      <div class="header-row">
        <div>
          <p class="eyebrow">TrialDiff</p>
          <h1>Open amendment evidence records</h1>
          <p class="lede">
            TrialDiff turns ClinicalTrials.gov amendment history into citeable evidence records: exact changed paths,
            source hashes, deterministic rules, timing context, and explicit claims-supported / claims-not-supported
            boundaries.
          </p>
        </div>
        <a class="button" href="https://clinicaltrials.gov/">
          Source registry
          <ExternalLink size={16} aria-hidden="true" />
        </a>
        <a class="button" href="https://github.com/AMBRA7592/trialdiff">
          Repository &amp; data
          <ExternalLink size={16} aria-hidden="true" />
        </a>
        <a class="button" href="/methodology">
          Methodology
        </a>
      </div>
    </header>

    <section class="panel panel-pad disclaimer">
      <div class="disclaimer-inner">
        <ShieldCheck size={20} aria-hidden="true" />
        <div>
          Severity is deterministic, reproducible, uncalibrated triage metadata, not validated review priority or proven wrongdoing. Evidence Records state what the registry history supports and what it does not support.
        </div>
      </div>
    </section>

    <section class="grid case-grid">
      <a class="panel case-card" href="/case-studies/nct01441947-secondary-outcome">
        <span class="case-icon"><BookOpen size={18} aria-hidden="true" /></span>
        <span>
          <span class="lens-title">Case Study A: read an Evidence Record</span>
          <span class="lens-description">
            A compact secondary-outcome record with five changed paths, one outcome rule, and explicit non-claims.
          </span>
        </span>
      </a>
      <a class="panel case-card" href="/case-studies/nct02942355-timeline-slip">
        <span class="case-icon"><BookOpen size={18} aria-hidden="true" /></span>
        <span>
          <span class="lens-title">Case Study B: late-stage timeline movement</span>
          <span class="lens-description">
            A 731-day timeline movement surfaced by deterministic triage without asserting intent or wrongdoing.
          </span>
        </span>
      </a>
    </section>

    <section class="grid stats-grid">
      <div class="panel panel-pad">
        <div class="stat-value">{formatNumber(data.summary.trialCount)}</div>
        <div class="stat-label">Trials</div>
      </div>
      <div class="panel panel-pad">
        <div class="stat-value">{formatNumber(data.summary.patchCount)}</div>
        <div class="stat-label">Adjacent patches</div>
      </div>
      <div class="panel panel-pad">
        <div class="stat-value">{formatNumber(data.summary.materialEventCount)}</div>
        <div class="stat-label">Material events</div>
      </div>
      <div class="panel panel-pad">
        <div class="stat-value">{formatNumber(data.summary.criticalCount)}</div>
        <div class="stat-label">Critical-triage events</div>
      </div>
      <div class="panel panel-pad">
        <div class="stat-value">{formatNumber(data.summary.highCount)}</div>
        <div class="stat-label">High-triage events</div>
      </div>
    </section>

    {
      data.databaseReady && (
        <p class="corpus-stamp">
          Corpus snapshot through {data.corpusStamp.maxSubmittedDate ?? "unknown date"} · {ruleSetLabel}
        </p>
      )
    }

    {
      !data.databaseReady && (
        <section class="panel panel-pad notice">
          <Database size={20} aria-hidden="true" />
          <div class="notice-title">Evidence database unavailable</div>
          <div>
            The corpus database is not reachable right now, so live feed data cannot render. If you are running
            locally, point <code>DATABASE_URL</code> at a migrated, seeded Postgres instance (see the frontend README)
            and reload.
          </div>
        </section>
      )
    }

    <section class="grid lens-grid">
      {
        (Object.keys(lensCopy) as Lens[]).map((lens) => {
          const Icon = lensIcons[lens];
          return (
            <a class={`panel lens ${activeLens === lens ? "lens-active" : ""}`} href={lensCopy[lens].href}>
              <span class="lens-content">
                <Icon size={20} aria-hidden="true" />
                <span>
                  <span class="lens-title">{lensCopy[lens].label}</span>
                  <span class="lens-description">{lensCopy[lens].description}</span>
                </span>
              </span>
            </a>
          );
        })
      }
    </section>

    {
      data.severityCounts.length > 0 && (
        <section class="grid severity-grid">
          {data.severityCounts.map((row) => (
            <div class="panel panel-pad">
              <span class={severityClass(row.severity)}>{severityLabel(row.severity)}</span>
              <div class="stat-value" style="margin-top: 12px">{formatNumber(row.count)}</div>
            </div>
          ))}
        </section>
      )
    }

    {
      activeLens === "post-completion" && (
        <section class="panel">
          <div class="section-head">
            <div>
              <h2>Post-recruitment Evidence Records</h2>
              <p class="section-subtitle">
                Covers completed, terminated, and suspended registry contexts after recruitment ended.
              </p>
            </div>
            <span class="section-count">{activeEvidenceRows.length} shown</span>
          </div>
          <div>
            {activeEvidenceRows.map((record) => {
              const rankedPaths = rankChangedPaths(record.changedPaths);
              return (
                <article class="event evidence-event">
                  <div>
                    <span class={severityClass(record.severity)}>{severityLabel(record.severity)}</span>
                    <div class="event-date">{record.submittedDate ?? "Date unavailable"}</div>
                  </div>
                  <div>
                    <div class="event-title">
                      <a href={`/events/${record.eventId}`}>{record.eventId}</a>
                    </div>
                    <div class="lede">
                      <a href={`/trials/${record.nctId}`}>{record.nctId}</a>
                      {" · "}
                      {record.briefTitle ?? "Untitled study"}
                    </div>
                    <div class="event-meta" style="margin-top: 10px">
                      <span>{titleCase(record.category)}</span>
                      <span>v{record.fromVersion} to v{record.toVersion}</span>
                      {record.timingContext && <span>{titleCase(record.timingContext)}</span>}
                      <span>Evidence v{record.evidenceVersion}</span>
                      {record.resultsConfound && (
                        <span class="chip chip-confound">Results posting co-occurs</span>
                      )}
                    </div>
                    {record.eventClasses.length > 0 && (
                      <div class="chip-row">
                        {record.eventClasses.map((eventClass) => (
                          <span class="chip chip-class">{eventClass}</span>
                        ))}
                      </div>
                    )}
                    {
                      record.resultsConfound && (
                        <div class="event-caveat">
                          Outcome paths changed while results were added. Treat as a deterministic triage
                          results-posting/reconciliation record, not a standalone outcome-switching example.
                        </div>
                      )
                    }
                  </div>
                  <div class="path-list">
                    {rankedPaths.slice(0, 2).map((path) => (
                      <div class="path-item" title={path}>{path}</div>
                    ))}
                    {record.changedPathCount > 2 && <div>{record.changedPathCount - 2} more paths</div>}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )
    }

    {
      activeLens !== "recent" && activeLens !== "post-completion" && (
        <section class="panel">
          <div class="section-head">
            <h2>{lensTitle}</h2>
            <span class="section-count">{activeRows.length} shown</span>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Trial</th>
                  <th>Sponsor</th>
                  <th class="right">Patches</th>
                  <th class="right">Critical triage</th>
                  <th class="right">High triage</th>
                  <th class="right">Critical-triage density</th>
                </tr>
              </thead>
              <tbody>
                {activeRows.map((row) => (
                  <tr>
                    <td>
                      <a href={`/trials/${row.nctId}`}><strong>{row.nctId}</strong></a>
                      <div class="trial-title">{row.briefTitle ?? "Untitled study"}</div>
                    </td>
                    <td>{row.leadSponsor ?? "Unknown"}</td>
                    <td class="right">{formatNumber(row.patchCount)}</td>
                    <td class="right">{formatNumber(row.criticalCount)}</td>
                    <td class="right">{formatNumber(row.highCount)}</td>
                    <td class="right">
                      {row.criticalDensityPct.toFixed(2)}%
                      <div class="table-note">critical-triage events / patches</div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section class="panel">
      <div class="section-head">
        <h2>Material event feed</h2>
        <span class="section-count">{data.recentEvents.length} shown</span>
      </div>
      <div>
        {
          data.recentEvents.map((event) => {
            const rankedPaths = rankChangedPaths(event.changedPaths);
            return (
              <article class="event">
                <div>
                  <span class={severityClass(event.severity)}>{severityLabel(event.severity)}</span>
                  <div class="event-date">{event.submittedDate ?? "Date unavailable"}</div>
                </div>
                <div>
                  <div class="event-title">
                    <a href={`/trials/${event.nctId}`}>{event.nctId}</a>
                  </div>
                  <div class="lede">{event.briefTitle ?? "Untitled study"}</div>
                  <div class="event-meta" style="margin-top: 10px">
                    <span>{titleCase(event.category)}</span>
                    <span>v{event.fromVersion} to v{event.toVersion}</span>
                    {event.timingContext && <span>{titleCase(event.timingContext)}</span>}
                    {event.needsHumanReview && <span>Human review</span>}
                    {event.resultsConfound && (
                      <span class="chip chip-confound">Results posting co-occurs</span>
                    )}
                    {event.evidenceEventId && <a href={`/events/${event.evidenceEventId}`}>Evidence Record</a>}
                  </div>
                </div>
                <div class="path-list">
                  {rankedPaths.slice(0, 2).map((path) => (
                    <div class="path-item" title={path}>{path}</div>
                  ))}
                  {event.changedPathCount > 2 && <div>{event.changedPathCount - 2} more paths</div>}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    {
      data.databaseReady && data.recentEvents.length === 0 && (
        <section class="panel panel-pad notice">
          <TriangleAlert size={20} aria-hidden="true" />
          No materiality events found in the connected database.
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .lens-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .lens-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .lens-grid {
      grid-template-columns: 1fr;
    }

    .case-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
